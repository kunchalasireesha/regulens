# Copy to .env.local and fill in. Never commit .env.local.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://regulens:regulens@localhost:5432/regulens

# AI provider: "gemini" or "mock".
# If unset, Gemini is used when GEMINI_API_KEY is present, otherwise mock extraction.
AI_PROVIDER=

# Free-tier key from https://aistudio.google.com/apikey (server-side only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Upload limits and local file storage
STORAGE_DIR=.data/uploads
MAX_UPLOAD_BYTES=10485760
MAX_PAGES=30
