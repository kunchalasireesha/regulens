# Copy to .env.local and fill in. Never commit .env.local.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://regulens:regulens@localhost:5432/regulens
# Connections per server instance. Keep it small behind a serverless pooler.
DATABASE_POOL_MAX=10

# AI provider: "gemini" or "mock".
# If unset, Gemini is used when GEMINI_API_KEY is present, otherwise mock extraction.
AI_PROVIDER=

# Free-tier key from https://aistudio.google.com/apikey (server-side only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# File storage: "local" or "supabase".
# If unset, Supabase Storage is used when SUPABASE_URL is present, otherwise local disk.
STORAGE_BACKEND=
STORAGE_DIR=.data/uploads
# Supabase project URL and secret key (server-side only); the bucket must be private.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Upload limits. MAX_DOCUMENTS caps documents per organization (unset: unlimited).
MAX_UPLOAD_BYTES=10485760
MAX_PAGES=30
MAX_DOCUMENTS=

# Password given to the seeded demo analyst (analyst@example.com) by `pnpm db:seed`.
# Defaults to "regulens-demo"; set a real one for any shared or deployed database.
DEMO_PASSWORD=
# "true" shows the demo account and DEMO_PASSWORD on the login page (public demo only;
# pair it with AI_PROVIDER=mock and MAX_DOCUMENTS).
PUBLIC_DEMO=
